# OpenBroker environment. Copy to .env.local (git-ignored). NEVER commit real keys.
#
# VITE_* variables are compiled into the public browser bundle: anything here is
# visible to every user. Put NO secrets in VITE_* variables.

# ---------------------------------------------------------------- front-end ---

# Which market-data/trading adapter the app boots with.
VITE_ADAPTER=

# Hyperliquid network: "mainnet" (default) or "testnet".
VITE_HL_NETWORK=mainnet

# Your builder (platform-fee) address. Lowercased automatically. Fees accrue here.
# Leave empty to disable the builder fee entirely.
VITE_HL_BUILDER_ADDRESS=

# Platform fee in TENTHS of a basis point. 100 = 0.10% (HL's perps maximum), 50 = 0.05%,
# 30 = 0.03%. Charged on every fill, both open and close. Values above 100 are clamped.
# Users approve exactly this rate, so RAISING it later forces re-approval.
# Default when unset: 100.
VITE_HL_BUILDER_FEE=100

# Optional remote kill switch / dynamic fee. JSON: {"enabled":true,"feeTenthsBp":50,"message":"..."}.
# Fetch failures keep the last known good value (fail-open). See docs/OPERATIONS.md.
VITE_FEE_CONFIG_URL=

# Optional geo-check endpoint used to block restricted jurisdictions.
VITE_GEO_CHECK_URL=

# ------------------------------------------------- operations scripts (Node) ---
# Used by `npm run builder:*`. Set these in your shell, a cron environment or CI
# secrets, not in a file that ships with the app.

# Network for the scripts (falls back to VITE_HL_NETWORK, then mainnet).
HL_NETWORK=mainnet

# Builder address for the scripts (falls back to VITE_HL_BUILDER_ADDRESS).
HL_BUILDER_ADDRESS=

# A user address that has approved the builder, to verify approvals in builder:health.
HL_TEST_USER=

# SECRET: builder wallet private key, only for `npm run builder:claim`.
# Keep it OUT of this file. Export it for the single command, or use a CI secret:
#   HL_BUILDER_PRIVATE_KEY=0x... npm run builder:claim -- --execute
# HL_BUILDER_PRIVATE_KEY=

# ------------------------------------------- compliance / security (front-end) ---
# All client-side compliance controls are ADVISORY; enforce the same rules at the edge.
# See docs/COMPLIANCE_CHECKLIST.md and docs/SECURITY_MODEL.md.

# What to do when the geo endpoint (VITE_GEO_CHECK_URL) is unreachable or returns garbage:
# "closed" (default, block) or "open" (allow). Choose "open" explicitly if you want it.
VITE_GEO_FAIL_MODE=closed

# Comma-separated ISO-3166 alpha-2 country codes that are always blocked, matched against the
# `country` returned by the geo endpoint. Example: US,GB,KP,IR
VITE_BLOCKED_COUNTRIES=

# Wallet-screening endpoint: GET <url>?address=0x... -> {"allowed": boolean}. Point it at YOUR
# edge function that holds the vendor API key. NEVER put a vendor key in a VITE_* variable.
# Empty = no screening. The wallet address is sent to this URL (disclose in your privacy policy).
VITE_SCREEN_URL=

# What to do when screening fails: "closed" (default, treat as blocked) or "open".
VITE_SCREEN_FAIL_MODE=closed

# Extra origins added to the CSP connect-src at BUILD time (comma/space separated), e.g. a
# private Arbitrum RPC or your geo/screen/fee-config hosts: https://rpc.example.com,https://edge.example.com
VITE_CSP_EXTRA_CONNECT=

# DEMO ONLY. "1" lets the CSP load TradingView embed scripts/iframes. These widgets are never
# rendered in Hyperliquid mode regardless of this flag; leave unset for production.
VITE_CSP_ALLOW_TRADINGVIEW=

# Base URL of the legacy demo backend (non-Hyperliquid builds only). Leave empty for the
# Hyperliquid build; if set, add its origin to VITE_CSP_EXTRA_CONNECT.
VITE_API_URL=
