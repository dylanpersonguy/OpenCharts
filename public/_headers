# GENERATED from src/hyperliquid/compliance/csp.ts (buildHeadersFile); a unit test fails if this drifts.
# The production build rewrites dist/_headers and ADDS the origins of VITE_GEO_CHECK_URL, VITE_SCREEN_URL,
# VITE_FEE_CONFIG_URL, VITE_API_URL and VITE_CSP_EXTRA_CONNECT to connect-src. If you deploy THIS file
# as-is, add those origins to connect-src by hand.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://api.hyperliquid.xyz wss://api.hyperliquid.xyz https://api.hyperliquid-testnet.xyz wss://api.hyperliquid-testnet.xyz https://arb1.arbitrum.io https://sepolia-rollup.arbitrum.io; frame-src 'none'; worker-src 'self'; manifest-src 'self'; media-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=(), interest-cohort=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin-allow-popups

/assets/*
  Cache-Control: public, max-age=31536000, immutable
