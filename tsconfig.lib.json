{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src", "vite-env.d.ts"],
  "exclude": ["src/__tests__", "src/main.tsx", "src/Root.tsx"]
}
